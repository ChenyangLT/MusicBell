<UserControl x:Class="MusicBell.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}">
    <Grid Margin="30,6,40,26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="392" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：唱片 -->
        <StackPanel Grid.Column="0" Margin="0,0,22,0">
            <Border Width="360" Height="360" CornerRadius="20" Background="{DynamicResource CardDeep}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" HorizontalAlignment="Left">
                <Grid>
                    <Border x:Name="CoverBox" CornerRadius="19" Background="{DynamicResource Card}" />
                    <TextBlock x:Name="CoverGlyph" Text="&#xE8D6;" FontFamily="{DynamicResource IconFont}" FontSize="64"
                               Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="TitleText" Text="还没有在放歌" FontSize="19" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" Margin="2,20,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SubText" Text="从日历点歌或在下边挑一首，会自动在内置播放器里播" FontSize="12.5"
                       Foreground="{DynamicResource TextDim}" Margin="2,6,0,0" TextWrapping="Wrap" />

            <Grid Margin="2,22,0,0">
                <Slider x:Name="SeekBar" Minimum="0" Maximum="1" Value="0" IsMoveToPointEnabled="True"
                        IsEnabled="False" VerticalAlignment="Center"
                        Thumb.DragStarted="SeekBar_DragStarted" Thumb.DragCompleted="SeekBar_DragCompleted" />
            </Grid>
            <Grid Margin="2,4,0,0">
                <TextBlock x:Name="PosText" Text="00:00" Style="{StaticResource Caption}" />
                <TextBlock x:Name="DurText" Text="00:00" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="RestartBtn" Style="{StaticResource IconButton}" Width="38" Height="38"
                        Content="&#xE72C;" FontSize="15" Click="Restart_Click" ToolTip="从头再来" />
                <Button x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" Width="76" Height="46" Padding="0"
                        Margin="10,0" Click="Play_Click" ToolTip="播放 / 暂停">
                    <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="17" />
                </Button>
                <Button x:Name="StopBtn" Style="{StaticResource IconButton}" Width="38" Height="38"
                        Content="&#xE71A;" FontSize="14" Click="Stop_Click" ToolTip="停止" />
                <TextBlock Text="&#xE767;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="20,0,6,0" />
                <Slider x:Name="VolumeBar" Width="96" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center"
                        ValueChanged="Volume_Changed" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Text="" FontSize="11.5" Foreground="{DynamicResource Danger}"
                       Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="ModeText" Text="" Style="{StaticResource Caption}" Margin="2,10,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 右：歌词 -->
        <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="22,16,18,8">
                    <TextBlock Text="歌词" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                    <TextBlock x:Name="LyricHint" Text="逐句滚动" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer x:Name="LyricScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" Padding="22,0,22,40">
                    <StackPanel x:Name="LyricPanel" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
