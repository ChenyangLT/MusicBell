<UserControl x:Class="MusicBell.App.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}">
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,6,40,26">
            <Grid Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="统计" Style="{StaticResource H1}" />
                    <TextBlock x:Name="HeadText" Text="排歌、点歌人、播放记录一眼看完" Style="{StaticResource Caption}"
                               VerticalAlignment="Bottom" Margin="12,0,0,4" />
                </StackPanel>
                <Button Content="刷新" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        Padding="16,6" Click="Refresh_Click" />
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelSoft}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="排歌总数" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatSongs" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,6,0,0" />
                        <TextBlock x:Name="StatSongsSub" Text="其中启用 0 首" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PanelSoft}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="累计播放" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatPlays" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,6,0,0" />
                        <TextBlock x:Name="StatPlaysSub" Text="按每条排歌的次数累加" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelSoft}" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="点歌人数" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatPeople" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,6,0,0" />
                        <TextBlock x:Name="StatPeopleSub" Text="名单里 0 人" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource PanelSoft}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="播放记录" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatRecords" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,6,0,0" />
                        <TextBlock x:Name="StatRecordsSub" Text="最近一次 —" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="点歌排行榜" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                        <TextBlock x:Name="RankHint" Text="按排歌条数排序，前 8 名" Style="{StaticResource Caption}" Margin="0,2,0,12" />
                        <StackPanel x:Name="RankPanel" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="排歌时段" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                        <TextBlock x:Name="HourHint" Text="0–23 点各排了几首" Style="{StaticResource Caption}" Margin="0,2,0,12" />
                        <Grid x:Name="HourPanel" Height="168" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="20,16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="重复方式" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                        <StackPanel x:Name="RepeatPanel" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="最近播放" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                        <TextBlock x:Name="RecentHint" Text="最近 10 条播放记录" Style="{StaticResource Caption}" Margin="0,2,0,10" />
                        <StackPanel x:Name="RecentPanel" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
