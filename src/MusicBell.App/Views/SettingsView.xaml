<UserControl x:Class="MusicBell.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,6,40,26">

            <TextBlock Text="设置" Style="{StaticResource H1}"/>
            <TextBlock Text="改动会立即生效并写进配置文件" Style="{StaticResource Caption}" Margin="0,6,0,0"/>

            <!-- 常规 -->
            <Border Style="{StaticResource Panel}" Margin="0,20,0,0" Padding="0">
                <StackPanel>
                    <TextBlock Text="常规" Style="{StaticResource H2}" Margin="18,16,0,4"/>
                    <Grid Margin="18,10,18,4">
                        <StackPanel>
                            <TextBlock Text="开机自启动" Style="{StaticResource Body}"/>
                            <TextBlock Text="登录 Windows 后自动静默启动，每 10 秒检查一次排歌" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="AutoStartHint" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <CheckBox x:Name="SwAutoStart" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="AutoStart" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="启动后静默在后台" Style="{StaticResource Body}"/>
                            <TextBlock Text="自启动时不动声色地待在托盘里，只在到点时才露面" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwSilentStart" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="SilentStart" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="关闭窗口时缩到托盘" Style="{StaticResource Body}"/>
                            <TextBlock Text="关掉就是隐藏，排歌继续在后台等你" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwTray" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="MinimizeToTray" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="到点弹小提示" Style="{StaticResource Body}"/>
                            <TextBlock Text="右下角弹出“现在放的是哪首”，不打扰上课" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwNotify" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="ShowNotification" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10,18,16">
                        <StackPanel>
                            <TextBlock Text="新排歌的默认时间" Style="{StaticResource Body}"/>
                            <TextBlock Text="点歌时时间框里预填的时刻（24 小时制）" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="DefaultTimeBox" Style="{StaticResource Input}" Width="110"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 TextAlignment="Center" LostFocus="DefaultTime_LostFocus"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10,18,16">
                        <StackPanel>
                            <TextBlock Text="外观主题" Style="{StaticResource Body}"/>
                            <TextBlock Text="深色适合教室大屏，浅色在白天更清爽" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="ThemeDark" Style="{StaticResource ChipToggle}" Content="深色" GroupName="Theme"
                                         Margin="0,0,7,0" Tag="dark" Click="Theme_Click"/>
                            <RadioButton x:Name="ThemeLight" Style="{StaticResource ChipToggle}" Content="浅色" GroupName="Theme"
                                         Margin="0,0,7,0" Tag="light" Click="Theme_Click"/>
                            <RadioButton x:Name="ThemeSystem" Style="{StaticResource ChipToggle}" Content="跟随系统" GroupName="Theme"
                                         Tag="system" Click="Theme_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 网易云 -->
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <TextBlock Text="网易云播放" Style="{StaticResource H2}" Margin="18,16,0,4"/>
                    <Grid Margin="18,10,18,4">
                        <StackPanel>
                            <TextBlock Text="网易云安装位置" Style="{StaticResource Body}"/>
                            <TextBlock Text="自动检测过，认不出来就手动选 cloudmusic.exe" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="NetEaseBox" Style="{StaticResource Input}" Width="430" FontSize="12" HorizontalContentAlignment="Left" Padding="10,8"
                                     LostFocus="NetEase_LostFocus"/>
                            <Button Content="检测" Style="{StaticResource GhostButton}" Padding="12,8" Margin="8,0,0,0"
                                    Click="NetEase_Detect_Click"/>
                            <Button Content="选择" Style="{StaticResource GhostButton}" Padding="12,8" Margin="8,0,0,0"
                                    Click="NetEase_Browse_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="试一次" Style="{StaticResource Body}"/>
                            <TextBlock Text="立刻用当前配置在网易云里搜一首，用来校准点击位置" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Content="测试播放「晴天」" Style="{StaticResource GhostButton}" Padding="14,8"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="TestPlay_Click"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="搜索框位置" Style="{StaticResource Body}"/>
                            <TextBlock Text="相对网易云窗口的比例，默认 0.304 / 0.042（点偏了就微调）" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="BoxX" Style="{StaticResource Input}" Width="78" TextAlignment="Center"
                                     LostFocus="Number_LostFocus" Tag="SearchBoxX"/>
                            <TextBlock Text="/" Foreground="{DynamicResource TextFaint}" Margin="8,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="BoxY" Style="{StaticResource Input}" Width="78" TextAlignment="Center"
                                     LostFocus="Number_LostFocus" Tag="SearchBoxY"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="键入等待" Style="{StaticResource Body}"/>
                            <TextBlock Text="每步操作之间的毫秒数，电脑慢就调大一点" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="DelayBox" Style="{StaticResource Input}" Width="80" TextAlignment="Center"
                                     LostFocus="Number_LostFocus" Tag="KeyDelayMs"/>
                            <TextBlock Text="ms" Foreground="{DynamicResource TextFaint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="提前量" Style="{StaticResource Body}"/>
                            <TextBlock Text="提前几秒开始操作，让音乐正好在整点响起" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="AdvanceBox" Style="{StaticResource Input}" Width="80" TextAlignment="Center"
                                     LostFocus="Number_LostFocus" Tag="AdvanceSeconds"/>
                            <TextBlock Text="秒" Foreground="{DynamicResource TextFaint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="用搜索框输入的方式播放" Style="{StaticResource Body}"/>
                            <TextBlock Text="关掉则直接调用 orpheus:// 拼链接播放" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwSearch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="PlayViaSearch" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="播放前把网易云叫到最前" Style="{StaticResource Body}"/>
                            <TextBlock Text="键盘输入需要窗口在前台，关掉可能打不进去" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwFront" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="BringNetEaseToFront" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10,18,16">
                        <StackPanel>
                            <TextBlock Text="播放后还原剪贴板" Style="{StaticResource Body}"/>
                            <TextBlock Text="输入靠剪贴板粘贴，用完放回原内容" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwClip" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="RestoreClipboard" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="自动播放搜到的第一首" Style="{StaticResource Body}"/>
                            <TextBlock Text="搜完双击第一条结果，让它真的唱起来；关掉只停在搜索结果页" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwAutoPlay" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="AutoPlayFirst" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="顺便打开歌曲详情页" Style="{StaticResource Body}"/>
                            <TextBlock Text="点底部封面进入全屏歌词页，大屏上更好看" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwNowPlaying" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="OpenNowPlaying" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10,18,16">
                        <StackPanel>
                            <TextBlock Text="播完自动关掉网易云" Style="{StaticResource Body}"/>
                            <TextBlock Text="按歌曲时长等它唱完再关，下课后不留窗口" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwCloseAfter" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="CloseNetEaseAfterPlay" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 播放与点歌方式 -->
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <TextBlock Text="播放与点歌方式" Style="{StaticResource H2}" Margin="18,16,0,4"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="放歌方式" Style="{StaticResource Body}"/>
                            <TextBlock Text="自动＝能直连就用内置播放器，不行再交给网易云客户端" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="ModeAuto" Content="自动" Style="{StaticResource ChipToggle}"
                                         GroupName="pm" Tag="auto" Checked="PlayMode_Checked" Margin="0,0,6,0"/>
                            <RadioButton x:Name="ModeBuiltin" Content="内置播放器" Style="{StaticResource ChipToggle}"
                                         GroupName="pm" Tag="builtin" Checked="PlayMode_Checked" Margin="0,0,6,0"/>
                            <RadioButton x:Name="ModeClient" Content="网易云客户端" Style="{StaticResource ChipToggle}"
                                         GroupName="pm" Tag="client" Checked="PlayMode_Checked"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="网易云 Cookie" Style="{StaticResource Body}"/>
                            <TextBlock Text="内置播放器要用它取直链；留空只能放免费歌" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="CookieBox" Style="{StaticResource Input}" Width="340" FontSize="11.5"
                                 HorizontalContentAlignment="Left" Padding="10,8" LostFocus="Cookie_LostFocus"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="点歌流程" Style="{StaticResource Body}"/>
                            <TextBlock x:Name="StepsText" Text="默认流程" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="编辑流程" Style="{StaticResource GhostButton}" Padding="12,8" Margin="0,0,8,0"
                                    Click="EditSteps_Click"/>
                            <Button Content="还原默认" Style="{StaticResource GhostButton}" Padding="12,8"
                                    Click="ResetSteps_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10,18,16">
                        <StackPanel>
                            <TextBlock Text="B 站防登录扩展" Style="{StaticResource Body}"/>
                            <TextBlock Text="释放一个浏览器扩展，自动关掉 B 站的登录弹窗" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="BrowserExtDirBox" Style="{StaticResource Input}" Width="210" FontSize="12"
                                     LostFocus="BrowserExtDir_LostFocus"/>
                            <Button Content="选择" Style="{StaticResource GhostButton}" Padding="12,8" Margin="8,0,0,0"
                                    Click="ChooseBrowserExtDir_Click"/>
                            <Button Content="释放扩展" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="8,0,0,0"
                                    Click="ExportBrowserExt_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="B 站播放时最大化浏览器" Style="{StaticResource Body}"/>
                            <TextBlock Text="打开视频后直接把浏览器窗口放到最大（系统调用，不模拟点击）" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwBiliMaximize" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="BiliMaximize" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="B 站播放时页面全屏" Style="{StaticResource Body}"/>
                            <TextBlock Text="在上面基础上再按一下 F11，只留页面本身；全屏时按 F11 或 Esc 可以退出" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwBiliFullscreen" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="BiliPageFullscreen" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 数据 -->
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <TextBlock Text="配置与数据" Style="{StaticResource H2}" Margin="18,16,0,4"/>
                    <Grid Margin="18,10,18,4">
                        <StackPanel>
                            <TextBlock Text="数据目录" Style="{StaticResource Body}"/>
                            <TextBlock x:Name="DataDirText" Text="" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="打开" Style="{StaticResource GhostButton}" Padding="12,8" Margin="0,0,8,0"
                                    Click="OpenDataDir_Click"/>
                            <Button Content="迁移到…" Style="{StaticResource GhostButton}" Padding="12,8" Margin="0,0,8,0"
                                    Click="MoveData_Click"/>
                            <Button Content="恢复默认" Style="{StaticResource GhostButton}" Padding="12,8"
                                    Click="ResetData_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="config.json 存设置，songs.json 存排歌；目录随便放，U 盘也行" Style="{StaticResource Caption}"
                               Margin="18,2,18,0"/>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,12,18,0"/>
                    <Grid Margin="18,10,18,16">
                        <StackPanel>
                            <TextBlock Text="运行日志" Style="{StaticResource Body}"/>
                            <TextBlock x:Name="LogPathText" Text="" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Content="打开日志" Style="{StaticResource GhostButton}" Padding="14,8"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenLog_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 联动 -->
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <TextBlock Text="ClassIsland 联动" Style="{StaticResource H2}" Margin="18,16,0,4"/>
                    <Grid Margin="18,10,18,4">
                        <StackPanel>
                            <TextBlock Text="musicbell:// 协议" Style="{StaticResource Body}"/>
                            <TextBlock Text="ClassIsland 的「行动」就是靠它来找本软件的" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="注册协议" Style="{StaticResource GhostButton}" Padding="12,8" Margin="0,0,8,0"
                                    Click="RegisterProtocol_Click"/>
                            <Button Content="复制示例链接" Style="{StaticResource GhostButton}" Padding="12,8"
                                    Click="CopyLink_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="启用协议响应" Style="{StaticResource Body}"/>
                            <TextBlock Text="关掉后 ClassIsland 叫不动本软件（软件内排歌仍然有效）" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwProtocol" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="EnableProtocol" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10,18,16">
                        <StackPanel>
                            <TextBlock Text="释放 ClassIsland 插件" Style="{StaticResource Body}"/>
                            <TextBlock Text="导出 .cipx 插件包和插件文件夹，再到 ClassIsland 里手动加载" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="PluginVersionText" Text="" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource AccentViolet}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="PluginDirBox" Style="{StaticResource Input}" Width="230" FontSize="12"
                                     LostFocus="PluginDir_LostFocus"/>
                            <Button Content="选择" Style="{StaticResource GhostButton}" Padding="12,8" Margin="8,0,0,0"
                                    Click="ChoosePluginDir_Click"/>
                            <Button Content="释放插件" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="8,0,0,0"
                                    Click="ExportPlugin_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 上课与课表 -->
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <TextBlock Text="上课与课表" Style="{StaticResource H2}" Margin="18,16,0,4"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="上课时不点歌" Style="{StaticResource Body}"/>
                            <TextBlock Text="排歌时间和上课撞上时直接跳过，下课再放" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwBlockClass" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="BlockDuringClass" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="上课前自动停掉正在放的东西" Style="{StaticResource Body}"/>
                            <TextBlock Text="总开关；提前多少秒、停哪些，见下面几行" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwCloseOnClass" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="CloseOnClass" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="提前量" Style="{StaticResource Body}"/>
                            <TextBlock Text="上课前多少秒开始停；0 = 正好打铃那一刻停" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="CloseLeadBox" Style="{StaticResource Input}" Width="72" FontSize="12"
                                     HorizontalContentAlignment="Center" LostFocus="Number_LostFocus" Tag="CloseLeadSeconds"/>
                            <TextBlock Text="秒" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="停掉内置播放器" Style="{StaticResource Body}"/>
                            <TextBlock Text="软件自己在放歌时直接暂停" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwStopBuiltin" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="StopBuiltinOnClass" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="关闭网易云客户端" Style="{StaticResource Body}"/>
                            <TextBlock Text="把 cloudmusic.exe 整个结束掉" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwCloseClient" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="CloseClientOnClass" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="只关 B 站那个标签页" Style="{StaticResource Body}"/>
                            <TextBlock Text="不关整个浏览器，只关放歌的那一页" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwCloseBili" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="CloseBiliTabOnClass" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10,18,16">
                        <StackPanel>
                            <TextBlock Text="ClassIsland 目录" Style="{StaticResource Body}"/>
                            <TextBlock Text="读它的课表来算「现在是不是上课」；留空会自动找桌面上的 ClassIsland" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="ClassStatusText" Text="" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource AccentViolet}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="自动检测" Style="{StaticResource GhostButton}" Padding="12,8" Margin="0,0,8,0"
                                    Click="AutoDetectClass_Click"/>
                            <Button Content="选择" Style="{StaticResource GhostButton}" Padding="12,8"
                                    Click="ChooseClassDir_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 更新 -->
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <TextBlock Text="版本与更新" Style="{StaticResource H2}" Margin="18,16,0,4"/>
                    <Grid Margin="18,10">
                        <StackPanel>
                            <TextBlock Text="启动时检查 GitHub 新版本" Style="{StaticResource Body}"/>
                            <TextBlock Text="只提醒，不自动下载；有新版会在右下角弹一下" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SwUpdate" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Tag="CheckUpdateOnStart" Checked="Switch_Toggled" Unchecked="Switch_Toggled"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}" Margin="18,0"/>
                    <Grid Margin="18,10,18,16">
                        <StackPanel>
                            <TextBlock Text="仓库" Style="{StaticResource Body}"/>
                            <TextBlock x:Name="UpdateStatusText" Text="还没检查过" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="RepoBox" Style="{StaticResource Input}" Width="190" FontSize="12"
                                     LostFocus="Repo_LostFocus"/>
                            <Button Content="立即检查" Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="8,0,0,0"
                                    Click="CheckUpdate_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
