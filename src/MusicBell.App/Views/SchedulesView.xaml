<UserControl x:Class="MusicBell.App.Views.SchedulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,6,30,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="我的排歌" Style="{StaticResource H1}"/>
                <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentSoft}"
                        BorderBrush="Transparent" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Text="0 首" FontSize="11" Foreground="{DynamicResource Accent}"/>
                </Border>
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Padding="18,9"
                    Click="New_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="新建排歌" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 筛选 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
            <RadioButton x:Name="FilterAll" Style="{StaticResource ChipToggle}" Content="全部" GroupName="Filter"
                         IsChecked="True" Margin="0,0,8,0" Click="Filter_Click" Tag="all"/>
            <RadioButton x:Name="FilterToday" Style="{StaticResource ChipToggle}" Content="今天" GroupName="Filter"
                         Margin="0,0,8,0" Click="Filter_Click" Tag="today"/>
            <RadioButton x:Name="FilterUpcoming" Style="{StaticResource ChipToggle}" Content="接下来 7 天" GroupName="Filter"
                         Margin="0,0,8,0" Click="Filter_Click" Tag="week"/>
            <RadioButton x:Name="FilterRepeat" Style="{StaticResource ChipToggle}" Content="重复的" GroupName="Filter"
                         Margin="0,0,8,0" Click="Filter_Click" Tag="repeat"/>
            <RadioButton x:Name="FilterDisabled" Style="{StaticResource ChipToggle}" Content="已停用" GroupName="Filter"
                         Click="Filter_Click" Tag="disabled"/>
        </StackPanel>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="8,6,8,10">
                    <ItemsControl x:Name="SongList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}" MouseLeftButtonDown="Row_MouseLeftButtonDown"
                                        Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                                Background="{DynamicResource FieldBg}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Grid>
                                                <Border CornerRadius="10" Background="{Binding Cover}" Visibility="{Binding CoverVis}"/>
                                                <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Visibility="{Binding CoverFaintVis}"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="1" Width="58" Height="44" CornerRadius="10"
                                                Background="{Binding TimeBg}" VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{Binding TimeFg}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding DateText}" FontSize="10"
                                                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5"
                                                           Foreground="{DynamicResource Text}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0"
                                                        Background="{DynamicResource FieldBg}" BorderBrush="Transparent"
                                                        Visibility="{Binding LabelVis}">
                                                    <TextBlock Text="{Binding LabelText}" FontSize="10"
                                                               Foreground="{DynamicResource AccentViolet}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SubLine}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="0,0,6,0">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"
                                                      Tag="{Binding}" Click="Toggle_Click" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="11"
                                                       Foreground="{DynamicResource TextFaint}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Width="46"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="&#xE768;" Style="{StaticResource IconButton}" Tag="{Binding}"
                                                    Click="Play_Click" ToolTip="现在试听一下"/>
                                            <Button Content="&#xE70F;" Style="{StaticResource IconButton}" Tag="{Binding}"
                                                    Click="Edit_Click" ToolTip="编辑"/>
                                            <Button Content="&#xE74D;" Style="{StaticResource IconButton}" Tag="{Binding}"
                                                    Click="Delete_Click" ToolTip="删除"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="66" Height="66" CornerRadius="20" Background="{DynamicResource FieldBg}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="26"
                                   Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="这里还没有排歌" Style="{StaticResource Body}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="去「日历点歌」里点一个日期，再搜歌名就行" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
