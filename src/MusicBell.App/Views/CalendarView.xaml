<UserControl x:Class="MusicBell.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}">
    <Grid Margin="24,4,24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="372" />
        </Grid.ColumnDefinitions>

        <!-- 日历 -->
        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <Grid DockPanel.Dock="Top" Margin="0,6,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MonthText" Text="2026年11月" Style="{StaticResource H1}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="PrevMonth_Click" Margin="16,4,0,0" ToolTip="上个月" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Click="NextMonth_Click" Margin="0,4,0,0" ToolTip="下个月" />
                    <Button Style="{StaticResource GhostButton}" Content="回到今天" Click="Today_Click" Margin="12,0,0,0" Padding="13,7" FontSize="12" />
                </StackPanel>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="BigAdd_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="点歌" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="4,0,4,8">
                <TextBlock Text="周一" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                <TextBlock Text="周二" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                <TextBlock Text="周三" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                <TextBlock Text="周四" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                <TextBlock Text="周五" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                <TextBlock Text="周六" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                <TextBlock Text="周日" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
            </UniformGrid>

            <ItemsControl x:Name="DayGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource DayCell}" Tag="{Binding}" Click="Day_Click"
                                Margin="3" Background="{Binding Bg}" BorderBrush="{Binding BorderBrush}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding DayNumber}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding Fg}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource AccentGrad}" CornerRadius="6" Height="13" Padding="4,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding TodayVis}">
                                        <TextBlock Text="今天" FontSize="8.5" Foreground="White" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Chips}" Margin="0,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="5" Background="{Binding Background}" Padding="4,3" Margin="0,0,0,3" ToolTip="{Binding Tip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="11" Height="11" CornerRadius="3" Background="{Binding Cover}"
                                                            Visibility="{Binding CoverVis}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10" Foreground="{Binding Fg}"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MoreText}" FontSize="9.5" Foreground="{DynamicResource TextFaint}" Margin="2,1,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- 选中日期 -->
        <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="18,16">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <StackPanel>
                        <TextBlock x:Name="SelDateText" Text="11月25日 周二" Style="{StaticResource H2}" />
                        <TextBlock x:Name="SelCountText" Text="这天还没有排歌" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" Click="AddOnDay_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="在这一天加一首" />
                </Grid>

                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="11" Height="42" x:Name="SearchShell">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         Style="{StaticResource Input}" Padding="0,0,8,0" FontSize="13"
                                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                                <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜歌名，或写「歌手 歌名」"
                                           Foreground="{DynamicResource TextFaint}" FontSize="12.5" VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Border x:Name="SuggestPanel" Visibility="Collapsed" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="11" Margin="0,8,0,0" MaxHeight="248" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SuggestList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Tag="{Binding}" Click="Suggest_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource FieldBg}"
                                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Border CornerRadius="8" Background="{Binding Cover}" Visibility="{Binding CoverVis}" />
                                                            <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                                                       Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding CoverFaintVis}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{DynamicResource TextFaint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="8,0,2,0" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Grid>
                        <ItemsControl x:Name="DaySongList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="11" Padding="4,3" Tag="{Binding}"
                                            MouseLeftButtonUp="SongRow_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource FieldBg}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <Border CornerRadius="8" Background="{Binding Cover}" Visibility="{Binding CoverVis}" />
                                                    <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                               Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding CoverFaintVis}" />
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="1" Background="{Binding TimeBg}" CornerRadius="8" Height="30" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{Binding TimeFg}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </Border>

                                            <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SubLine}" FontSize="10.5" Foreground="{DynamicResource TextFaint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="12" Tag="{Binding}" Click="RowPlay_Click" ToolTip="现在播放" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" Tag="{Binding}" Click="RowDelete_Click" ToolTip="删除" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Margin="0,34,0,0" IsHitTestVisible="False">
                            <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource IconFont}" FontSize="26"
                                       Foreground="{DynamicResource CellTextOut}" HorizontalAlignment="Center" />
                            <TextBlock Text="这一天还很安静" FontSize="12.5" Foreground="{DynamicResource TextFaint}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="下面输入歌名，就能排一首" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
