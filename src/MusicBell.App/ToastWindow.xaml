<Window x:Class="MusicBell.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="372" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False">
    <Border x:Name="Shell" Margin="14" Background="#F2161A22" CornerRadius="16"
            BorderBrush="#2E3645" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="16,0,0,16" Background="{DynamicResource AccentGrad}" Margin="0,0,0,0" />
            <Grid Grid.Column="1" Margin="16,14,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="11" Background="#24FFFFFF" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" Text="&#xE768;" FontFamily="{DynamicResource IconFont}"
                               FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="#F2F5F9" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubText" FontSize="12" Foreground="#9AA4B5" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FootText" FontSize="11" Foreground="#69717F" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
