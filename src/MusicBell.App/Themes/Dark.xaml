<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基础色板 -->
    <SolidColorBrush x:Key="Bg" Color="#0B0D12" />
    <SolidColorBrush x:Key="BgSoft" Color="#0F1218" />
    <SolidColorBrush x:Key="Sidebar" Color="#0E1117" />
    <SolidColorBrush x:Key="Card" Color="#141821" />
    <SolidColorBrush x:Key="CardHover" Color="#1B2029" />
    <SolidColorBrush x:Key="CardDeep" Color="#10141B" />
    <SolidColorBrush x:Key="FieldBg" Color="#12161E" />
    <SolidColorBrush x:Key="Border" Color="#232935" />
    <SolidColorBrush x:Key="BorderStrong" Color="#333C4B" />
    <SolidColorBrush x:Key="Text" Color="#F2F5F9" />
    <SolidColorBrush x:Key="TextDim" Color="#9AA4B5" />
    <SolidColorBrush x:Key="TextFaint" Color="#69717F" />
    <SolidColorBrush x:Key="Accent" Color="#FF5A7A" />
    <SolidColorBrush x:Key="AccentDeep" Color="#D8476A" />
    <SolidColorBrush x:Key="AccentViolet" Color="#B07CFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2A1720" />
    <SolidColorBrush x:Key="AccentSoft2" Color="#2B1D33" />
    <SolidColorBrush x:Key="Success" Color="#4FD1A5" />
    <SolidColorBrush x:Key="Warn" Color="#FFC46B" />
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
    <SolidColorBrush x:Key="White" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5F7E" Offset="0" />
        <GradientStop Color="#B07CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowGrad" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#0B0D12" Offset="0" />
        <GradientStop Color="#0D1017" Offset="0.55" />
        <GradientStop Color="#0B0D12" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#39414F" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#4C5668" />
    <SolidColorBrush x:Key="ChipToggleBg" Color="#151922" />
    <SolidColorBrush x:Key="SwitchTrack" Color="#2A3140" />
    <SolidColorBrush x:Key="SwitchThumb" Color="#8B94A5" />
    <SolidColorBrush x:Key="NavActive" Color="#1E2330" />
    <SolidColorBrush x:Key="ChipBg" Color="#1A1F29" />
    <SolidColorBrush x:Key="ToolTipBg" Color="#1B2029" />

    <!-- 日历 / 排歌列表用色 -->
    <SolidColorBrush x:Key="SelBg" Color="#26182A" />
    <SolidColorBrush x:Key="SelBorder" Color="#FF5A7A" />
    <SolidColorBrush x:Key="TodayBg" Color="#151B25" />
    <SolidColorBrush x:Key="TodayBorder" Color="#2E3644" />
    <SolidColorBrush x:Key="TileBg" Color="#0F131B" />
    <SolidColorBrush x:Key="TileBorder" Color="#1A202A" />
    <SolidColorBrush x:Key="CellChipSelBg" Color="#3A2030" />
    <SolidColorBrush x:Key="CellChipBg" Color="#1D2029" />
    <SolidColorBrush x:Key="CellText" Color="#E7ECF5" />
    <SolidColorBrush x:Key="CellTextDim" Color="#8791A1" />
    <SolidColorBrush x:Key="CellTextOut" Color="#4A515E" />
    <SolidColorBrush x:Key="ChipTextOn" Color="#FF8FA4" />
    <SolidColorBrush x:Key="ChipOnBg" Color="#3A2030" />
    <SolidColorBrush x:Key="ChipOffBg" Color="#1A1F2A" />
    <SolidColorBrush x:Key="ChipOffFg" Color="#6B7484" />
    <SolidColorBrush x:Key="TrackBg" Color="#20262F" />
    <SolidColorBrush x:Key="WinBorder" Color="#1C2129" />
</ResourceDictionary>
