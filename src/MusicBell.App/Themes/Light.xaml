<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题色板：键名与 Dark.xaml 完全一致 -->

    <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="Bg" Color="#F4F6FA" />
    <SolidColorBrush x:Key="BgSoft" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Sidebar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHover" Color="#EFF2F8" />
    <SolidColorBrush x:Key="CardDeep" Color="#F8FAFD" />
    <SolidColorBrush x:Key="FieldBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Border" Color="#E3E7F0" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C9D0DE" />
    <SolidColorBrush x:Key="Text" Color="#16181F" />
    <SolidColorBrush x:Key="TextDim" Color="#5C6473" />
    <SolidColorBrush x:Key="TextFaint" Color="#8A93A3" />
    <SolidColorBrush x:Key="Accent" Color="#F2466B" />
    <SolidColorBrush x:Key="AccentDeep" Color="#D22F55" />
    <SolidColorBrush x:Key="AccentViolet" Color="#8A5CF6" />
    <SolidColorBrush x:Key="AccentSoft" Color="#FFE9EF" />
    <SolidColorBrush x:Key="AccentSoft2" Color="#F1EBFF" />
    <SolidColorBrush x:Key="Success" Color="#12A46F" />
    <SolidColorBrush x:Key="Warn" Color="#C4841A" />
    <SolidColorBrush x:Key="Danger" Color="#E04347" />
    <SolidColorBrush x:Key="White" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5F7E" Offset="0" />
        <GradientStop Color="#B07CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowGrad" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#F4F6FA" Offset="0" />
        <GradientStop Color="#FBFCFF" Offset="0.55" />
        <GradientStop Color="#F2F5FA" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C6CDDB" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A7B0C1" />
    <SolidColorBrush x:Key="ChipToggleBg" Color="#F4F6FB" />
    <SolidColorBrush x:Key="SwitchTrack" Color="#DCE1EC" />
    <SolidColorBrush x:Key="SwitchThumb" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavActive" Color="#FFEAF0" />
    <SolidColorBrush x:Key="ChipBg" Color="#F1F4FA" />
    <SolidColorBrush x:Key="ToolTipBg" Color="#22262F" />

    <!-- 日历 / 排歌列表用色 -->
    <SolidColorBrush x:Key="SelBg" Color="#FFE7EE" />
    <SolidColorBrush x:Key="SelBorder" Color="#F2466B" />
    <SolidColorBrush x:Key="TodayBg" Color="#F2F5FB" />
    <SolidColorBrush x:Key="TodayBorder" Color="#C9D0DE" />
    <SolidColorBrush x:Key="TileBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileBorder" Color="#E8ECF4" />
    <SolidColorBrush x:Key="CellChipSelBg" Color="#FFD9E3" />
    <SolidColorBrush x:Key="CellChipBg" Color="#F1F4FA" />
    <SolidColorBrush x:Key="CellText" Color="#1B1E26" />
    <SolidColorBrush x:Key="CellTextDim" Color="#5C6473" />
    <SolidColorBrush x:Key="CellTextOut" Color="#B3BAC7" />
    <SolidColorBrush x:Key="ChipTextOn" Color="#D22F55" />
    <SolidColorBrush x:Key="ChipOnBg" Color="#FFE1E9" />
    <SolidColorBrush x:Key="ChipOffBg" Color="#F0F2F8" />
    <SolidColorBrush x:Key="ChipOffFg" Color="#8A93A3" />
    <SolidColorBrush x:Key="TrackBg" Color="#E6EAF2" />
    <SolidColorBrush x:Key="WinBorder" Color="#DCE1EC" />
</ResourceDictionary>
