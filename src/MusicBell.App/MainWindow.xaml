<Window x:Class="MusicBell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MusicBell 点歌铃" Height="868" Width="1310" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource WindowGrad}"
        Icon="Assets/app.ico" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" FontFamily="{DynamicResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource WinBorder}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource AccentGrad}">
                        <TextBlock Text="&#x266A;" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MusicBell" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="点歌铃" FontSize="11.5" Foreground="{DynamicResource TextFaint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ThemeBtn" Style="{StaticResource IconButton}" Content="&#xE706;" FontSize="13" Click="Theme_Click" ToolTip="切换深色 / 浅色" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="11" Click="Min_Click" ToolTip="最小化" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE922;" FontSize="11" Click="Max_Click" ToolTip="最大化" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- 主体 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource WinBorder}" BorderThickness="0,1,1,0" CornerRadius="0,0,0,10">
                    <DockPanel Margin="12,6,12,12">
                        <StackPanel DockPanel.Dock="Bottom">
                            <!-- 课程卡片 -->
                            <Border x:Name="ClassCard" Style="{StaticResource PanelSoft}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="ClassTag" Text="课表" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="ClassClock" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock x:Name="ClassTitle" Text="读取课表中…" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ClassSub" Text="—" FontSize="11" Foreground="{DynamicResource TextDim}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="ClassBar" Style="{StaticResource Bar}" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelSoft}" Padding="12,10" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="下一个排歌" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="NextTitle" Text="—" FontSize="12.5" Foreground="{DynamicResource Text}"
                                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="NextTime" Text="还没有安排" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Click="QuickAdd_Click" Padding="0,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="快速点歌" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
                                <TextBlock x:Name="VersionText" Text="v1.0" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="AuthorLink" Text="by Chen_yang_LT" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                           Cursor="Hand" MouseLeftButtonUp="Author_Click" ToolTip="打开作者的 GitHub" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <RadioButton x:Name="NavCalendar" Style="{StaticResource NavItem}" GroupName="nav" Tag="calendar" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="{DynamicResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="日历点歌" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavPlayer" Style="{StaticResource NavItem}" GroupName="nav" Tag="player" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="播放器" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSchedules" Style="{StaticResource NavItem}" GroupName="nav" Tag="schedules" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="我的排歌" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavPeople" Style="{StaticResource NavItem}" GroupName="nav" Tag="people" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE716;" FontFamily="{DynamicResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="点歌人" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavStats" Style="{StaticResource NavItem}" GroupName="nav" Tag="stats" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="统计" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="settings" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="设置" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="nav" Tag="about" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="联动与帮助" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Column="1" x:Name="Host" Margin="0" />
            </Grid>
        </Grid>
    </Border>
</Window>
