<Window x:Class="MusicBell.App.Dialogs.PlayStepsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="点歌流程" Width="742" SizeToContent="Height" MaxHeight="860"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Margin="20" CornerRadius="18" Background="{DynamicResource Card}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="58" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentGrad}">
                        <TextBlock Text="&#xE8EF;" Style="{StaticResource Glyph}" FontSize="15"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="点歌流程" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Text="0 步" Style="{StaticResource Caption}" Foreground="{DynamicResource TextDim}"/>
                    </Border>
                </StackPanel>
                <Button Content="&#xE711;" Style="{StaticResource IconButton}" Width="32" Height="32"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                        Click="Cancel_Click"/>
            </Grid>

            <!-- 步骤列表 -->
            <ScrollViewer Grid.Row="1" MaxHeight="600" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel Margin="22,2,16,0">
                    <TextBlock x:Name="HintText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="到点后按顺序照做：点哪里、粘贴什么、要不要等切歌。位置都存成相对网易云窗口的比例，换分辨率也不会偏。"/>

                    <ItemsControl x:Name="StepList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PanelSoft}" Margin="0,0,0,8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="7"
                                                Background="{DynamicResource ChipBg}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Index}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextDim}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text}"
                                                       FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding EditText, Mode=OneWay}" Style="{StaticResource Input}"
                                                     Margin="0,7,0,0" Padding="9,6" FontSize="12"
                                                     Visibility="{Binding EditVis}" Tag="{Binding}"
                                                     TextChanged="EditText_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="拾取" Style="{StaticResource GhostButton}" Padding="10,5"
                                                    FontSize="12" Tag="{Binding}" Click="Pick_Click"
                                                    Visibility="{Binding PickVis}"/>
                                            <Button Content="&#xE70E;" Style="{StaticResource IconButton}" Tag="{Binding}"
                                                    Click="Up_Click" Margin="6,0,0,0"/>
                                            <Button Content="&#xE70D;" Style="{StaticResource IconButton}" Tag="{Binding}"
                                                    Click="Down_Click" Margin="4,0,0,0"/>
                                            <Button Content="&#xE74D;" Style="{StaticResource IconButton}" Tag="{Binding}"
                                                    Click="Delete_Click" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyText" Text="还没有步骤，点下面的按钮加一步。" Style="{StaticResource Caption}"
                               Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,18,0,18"/>

                    <TextBlock Text="加一步" Style="{StaticResource FieldLabel}" Margin="0,10,0,8"/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="点击" Style="{StaticResource GhostButton}" Tag="click" Click="Add_Click" Margin="0,0,8,8"/>
                        <Button Content="双击" Style="{StaticResource GhostButton}" Tag="doubleClick" Click="Add_Click" Margin="0,0,8,8"/>
                        <Button Content="粘贴歌名" Style="{StaticResource GhostButton}" Tag="paste" Click="Add_Click" Margin="0,0,8,8"/>
                        <Button Content="按键" Style="{StaticResource GhostButton}" Tag="key" Click="Add_Click" Margin="0,0,8,8"/>
                        <Button Content="等一会" Style="{StaticResource GhostButton}" Tag="wait" Click="Add_Click" Margin="0,0,8,8"/>
                        <Button Content="打开链接" Style="{StaticResource GhostButton}" Tag="url" Click="Add_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Grid Grid.Row="2" Margin="22,10,22,18">
                <Button Content="还原默认流程" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Click="Reset_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="保存流程" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
